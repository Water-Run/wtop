{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:dev:waterrun:wtop:agent:v1",
  "title": "wtop Agent context v1",
  "description": "Bounded, privacy-aware telemetry context emitted by wtop --agent.",
  "type": "object",
  "required": [
    "schema",
    "producer",
    "host",
    "sequence",
    "captured_unix_ns",
    "captured_monotonic_ns",
    "privilege",
    "overall",
    "metrics",
    "signals",
    "top",
    "data_quality",
    "unavailable_sources",
    "privacy"
  ],
  "properties": {
    "schema": { "const": "dev.waterrun.wtop.agent/v1" },
    "producer": {
      "type": "object",
      "required": ["name", "version"],
      "properties": {
        "name": { "const": "wtop" },
        "version": { "type": "string", "minLength": 1, "maxLength": 128 }
      },
      "additionalProperties": true
    },
    "host": { "type": "object", "additionalProperties": true },
    "sequence": { "type": "integer", "minimum": 0 },
    "captured_unix_ns": { "type": "integer", "minimum": 0 },
    "captured_monotonic_ns": { "type": "integer", "minimum": 0 },
    "privilege": {
      "type": "object",
      "properties": {
        "mode": { "enum": ["user", "root", "unknown"] },
        "uid": { "type": "integer", "minimum": 0 },
        "effective_uid": { "type": "integer", "minimum": 0 },
        "original_uid": { "type": "integer", "minimum": 0 },
        "root": { "type": "boolean" },
        "elevated": { "type": "boolean" },
        "via_sudo": { "type": "boolean" },
        "requested": { "type": "boolean" }
      },
      "additionalProperties": true
    },
    "overall": {
      "type": "object",
      "required": ["state", "signal_count"],
      "properties": {
        "state": { "enum": ["ok", "warning", "critical", "unknown"] },
        "signal_count": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": true
    },
    "metrics": {
      "type": "object",
      "required": ["cpu", "memory", "pressure", "storage", "network", "gpu", "power", "sensors", "processes"],
      "properties": {
        "cpu": { "$ref": "#/$defs/metricObject" },
        "memory": { "$ref": "#/$defs/metricObject" },
        "pressure": { "$ref": "#/$defs/metricObject" },
        "storage": { "$ref": "#/$defs/metricObject" },
        "network": { "$ref": "#/$defs/metricObject" },
        "gpu": { "$ref": "#/$defs/metricObject" },
        "power": { "$ref": "#/$defs/metricObject" },
        "sensors": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "fan_controls": {
              "type": "array",
              "maxItems": 5,
              "description": "Read-only driver settings, not measured rotation or proof of applied output.",
              "items": {
                "type": "object",
                "additionalProperties": true,
                "required": [
                  "id",
                  "device_id",
                  "settings_only"
                ],
                "properties": {
                  "id": {
                    "$ref": "#/$defs/boundedString"
                  },
                  "device_id": {
                    "$ref": "#/$defs/boundedString"
                  },
                  "settings_only": {
                    "type": "boolean",
                    "const": true
                  },
                  "raw_value": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 255
                  },
                  "setting_percent": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 100
                  },
                  "enable_code": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 2147483647
                  },
                  "output_mode_code": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 2147483647
                  },
                  "control_method": {
                    "enum": [
                      "full_speed",
                      "manual",
                      "automatic"
                    ]
                  },
                  "output_mode": {
                    "enum": [
                      "dc",
                      "pwm"
                    ]
                  },
                  "frequency_hz": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 2147483647
                  },
                  "temperature_channels_mask": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "temperature_inputs": {
                    "type": "array",
                    "maxItems": 53,
                    "items": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 53
                    }
                  },
                  "quality": {
                    "$ref": "#/$defs/boundedString"
                  }
                }
              }
            },
            "fan_controls_total": {
              "type": "integer",
              "minimum": 0
            },
            "fan_controls_truncated": {
              "type": "boolean"
            }
          }
        },
        "firmware_probes": {
          "type": "object",
          "additionalProperties": true,
          "description": "SMBIOS probe and cooling declarations. Nominal values, readable ranges and reported status are not live measurements or alarm thresholds.",
          "required": [
            "declarations_only",
            "probes",
            "cooling_devices"
          ],
          "properties": {
            "declarations_only": {
              "type": "boolean",
              "const": true
            },
            "probes": {
              "type": "array",
              "maxItems": 5,
              "items": {
                "type": "object",
                "additionalProperties": true,
                "required": [
                  "id",
                  "probe_type",
                  "unit"
                ],
                "properties": {
                  "minimum": {
                    "type": "number"
                  },
                  "maximum": {
                    "type": "number"
                  },
                  "resolution": {
                    "type": "number"
                  },
                  "tolerance": {
                    "type": "number"
                  },
                  "accuracy_percent": {
                    "type": "number"
                  },
                  "nominal_value": {
                    "type": "number"
                  },
                  "handle": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "structure_type": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "location_code": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "status_code": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "minimum_raw": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "maximum_raw": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "resolution_raw": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "tolerance_raw": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "accuracy_percent_raw": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "nominal_value_raw": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "id": {
                    "type": "string"
                  },
                  "probe_type": {
                    "type": "string",
                    "enum": [
                      "voltage",
                      "temperature",
                      "current"
                    ]
                  },
                  "unit": {
                    "type": "string",
                    "enum": [
                      "volts",
                      "celsius",
                      "amperes"
                    ]
                  },
                  "description": {
                    "type": "string",
                    "maxLength": 256
                  }
                }
              }
            },
            "cooling_devices": {
              "type": "array",
              "maxItems": 5,
              "items": {
                "type": "object",
                "additionalProperties": true,
                "required": [
                  "id"
                ],
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "nominal_speed_rpm": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "temperature_probe_id": {
                    "type": "string"
                  },
                  "description": {
                    "type": "string",
                    "maxLength": 256
                  }
                }
              }
            }
          }
        },
        "processes": { "$ref": "#/$defs/metricObject" }
      },
      "additionalProperties": true
    },
    "signals": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["resource", "code", "severity", "message"],
        "properties": {
          "resource": { "$ref": "#/$defs/boundedString" },
          "code": { "$ref": "#/$defs/boundedString" },
          "severity": { "enum": ["warning", "critical"] },
          "value": { "type": "number" },
          "unit": { "$ref": "#/$defs/boundedString" },
          "message": { "type": "string", "maxLength": 1024 }
        },
        "additionalProperties": true
      }
    },
    "top": {
      "type": "object",
      "required": ["processes", "disks", "interfaces", "workloads", "gpus", "sensors"],
      "properties": {
        "processes": { "type": "array", "maxItems": 10, "items": { "type": "object" } },
        "disks": { "type": "array", "maxItems": 5, "items": { "type": "object" } },
        "interfaces": { "type": "array", "maxItems": 5, "items": { "type": "object" } },
        "workloads": { "type": "array", "maxItems": 5, "items": { "type": "object" } },
        "gpus": { "type": "array", "maxItems": 5, "items": { "type": "object" } },
        "usb_interfaces": { "type": "array", "maxItems": 5, "items": {
          "type": "object", "properties": {
            "endpoint_details": { "type": "object", "properties": {
              "list": { "type": "array", "maxItems": 30, "items": { "type": "object" } }
            } }
          }
        } },
        "sensors": { "type": "array", "maxItems": 50, "items": { "type": "object" } }
      },
      "additionalProperties": true
    },
    "data_quality": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["resource"],
        "properties": {
          "resource": { "$ref": "#/$defs/boundedString" },
          "status": { "$ref": "#/$defs/boundedString" },
          "quality": { "$ref": "#/$defs/boundedString" },
          "reason": { "type": "string", "maxLength": 4096 },
          "value_timestamp_ns": { "type": "number", "minimum": 0 },
          "value_age_ms": { "type": "integer", "minimum": 0 }
        },
        "additionalProperties": true
      }
    },
    "unavailable_sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id"],
        "properties": {
          "id": { "$ref": "#/$defs/boundedString" },
          "state": { "$ref": "#/$defs/boundedString" },
          "reason": { "type": "string", "maxLength": 4096 }
        },
        "additionalProperties": true
      }
    },
    "privacy": {
      "type": "object",
      "required": ["remote_addresses", "process_commands"],
      "properties": {
        "remote_addresses": { "const": "omitted" },
        "process_commands": { "const": "omitted" }
      },
      "additionalProperties": true
    }
  },
  "$defs": {
    "boundedString": { "type": "string", "minLength": 1, "maxLength": 256 },
    "metricObject": { "type": "object", "additionalProperties": true }
  },
  "additionalProperties": true
}
